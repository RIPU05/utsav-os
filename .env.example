# ==============================================================================
# Aayojan Ace Pro - Environment Variables Template
# ==============================================================================
# Strictly SERVER-ONLY environment variables.
# NEVER prefix confidential keys with NEXT_PUBLIC_

# Google Gemini API Key (Required for server-side AI generation & streaming)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Configuration (Optional overrides)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Security & Rate Limiting (Optional)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
